# Usuario de TikTok (sin el @) que hará el directo
TIKTOK_USERNAME=

# Tu nombre de jugador dentro de Minecraft (para los comandos {player}; si está vacío usa @p)
PLAYER_NAME=

# Configuración del servidor RCON de Minecraft (coincide con server.properties)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=minecraft_rcon_local

# Modo Simulador RCON:
# true  = No requiere servidor de Minecraft activo; imprime en consola los comandos que se enviarían.
# false = Se conecta por RCON real a tu servidor de Minecraft.
MOCK_RCON=false

