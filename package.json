{
  "name": "minecraft-tiktok-rcon",
  "version": "2.1.0",
  "description": "Puente y estudio visual 100% gratuito entre TikTok Live y Minecraft: Java Edition mediante RCON para spawnear mobs y dar ítems en tiempo real.",
  "type": "module",
  "main": "src/electronMain.js",
  "scripts": {
    "start": "node src/index.js",
    "gui": "node src/guiServer.js",
    "app": "bash ./launch-app.sh",
    "desktop": "electron src/electronMain.js",
    "dist:linux": "npx electron-builder --linux AppImage --publish never",
    "dist:win": "npx electron-builder --win portable --publish never",
    "simulate": "node src/simulate.js"
  },
  "build": {
    "appId": "com.tiktokbridge.minecraftrcon",
    "productName": "MinecraftTikTokLive",
    "files": [
      "src/**/*",
      "public/**/*",
      "config/gifts.json",
      ".env.example",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "public/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "dotenv": "latest",
    "rcon-client": "latest",
    "tiktok-live-connector": "latest"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}

